<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Manifest merge ile uygulamaya eklenir; müşteri ek servis tanımlamaz. -->
        <service
            android:name=".HeroSignalMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Bildirim/düğme tıklaması: Android 12+ trampoline kısıtına uygun, arayüzsüz Activity. -->
        <activity
            android:name=".NotificationOpenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Önceki SDK sürümlerinin gösterdiği bildirimler için (geriye dönük uyumluluk). -->
        <receiver
            android:name=".NotificationOpenedReceiver"
            android:exported="false" />

        <!-- Bildirim kaydırılıp kapatıldığında dismissed bildirimi. -->
        <receiver
            android:name=".NotificationDismissedReceiver"
            android:exported="false" />

        <!-- Varsayılan bildirim ikonu ve kanal; uygulama meta-data ile ezebilir. -->
        <meta-data
            android:name="com.herosignal.sdk.default_notification_icon"
            android:resource="@drawable/hs_ic_notification" />
    </application>
</manifest>

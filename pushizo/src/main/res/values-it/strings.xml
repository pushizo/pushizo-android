    <string name="hs_location_rationale_title">Condivida la sua posizione</string>
    <string name="hs_location_rationale_message">Utilizziamo la sua posizione approssimativa solo mentre l\'app è aperta, per inviarle notifiche pertinenti nelle vicinanze. Può disattivare questa opzione in qualsiasi momento.</string>
    <string name="hs_location_rationale_continue">Continua</string>

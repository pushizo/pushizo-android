    <string name="hs_location_rationale_title">Deel uw locatie</string>
    <string name="hs_location_rationale_message">We gebruiken uw geschatte locatie alleen terwijl de app geopend is, om u relevante meldingen uit de buurt te sturen. U kunt dit op elk moment uitschakelen.</string>
    <string name="hs_location_rationale_continue">Doorgaan</string>
